<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup> 
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
	</startup>
	<!--
		SqlRunnerExePath is machine-specific (points at a dev-only tool install)
		and must NOT be committed with a real value. The actual value lives in
		SqlRunner.local.config, which is git-ignored; see
		SqlRunner.local.config.example for the expected format/key. If that file
		is missing, SqlRunnerExePath falls back to string.Empty and any test mode
		that needs SQLRunner will report it as "not found" and skip gracefully.
	-->
	<appSettings file="SqlRunner.local.config">
		<add key="SqlRunnerExePath" value="" />
	</appSettings>
	<connectionStrings>
		<add name="Test" connectionString="Data Source=.;Initial Catalog=Data;" />
	</connectionStrings>
</configuration>